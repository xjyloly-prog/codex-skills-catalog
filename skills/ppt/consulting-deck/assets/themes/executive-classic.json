  "mode": "light",
  "colors": {
    "paper": "#F8FAFC",
    "surface": "#FFFFFF",
    "ink": "#071C33",
    "navy": "#0B2A4A",
    "accent": "#1769E0",
    "muted": "#667384",
    "line": "#D8E0E7",
